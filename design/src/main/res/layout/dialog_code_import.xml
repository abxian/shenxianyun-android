<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sxy_code_dialog"
    android:clipToOutline="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_sxy_switch_code"
            android:importantForAccessibility="no"
            android:padding="13dp"
            android:src="@drawable/ic_baseline_cloud_download"
            app:tint="@color/sxy_purple" />

        <TextView
            android:id="@+id/code_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/import_code_title"
            android:textColor="@color/sxy_text_soft"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/code_dialog_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_sxy_code_input"
            android:backgroundTint="@null"
            android:hint="@string/import_code_hint"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword"
            android:minHeight="56dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/sxy_text_soft"
            android:textColorHint="@color/sxy_text_muted" />

        <ProgressBar
            android:id="@+id/code_dialog_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no"
            android:indeterminate="true"
            android:indeterminateTint="@color/sxy_purple"
            android:visibility="gone" />

        <TextView
            android:id="@+id/code_dialog_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/import_code_guidance"
            android:textColor="@color/sxy_text_soft"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/code_dialog_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="52dp"
            android:text="@string/import_code_confirm"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/sxy_purple"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/code_dialog_other"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/import_other_subscription"
            android:textAllCaps="false"
            android:textColor="@color/sxy_text_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/code_dialog_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/sxy_text_soft" />
    </LinearLayout>
</ScrollView>
